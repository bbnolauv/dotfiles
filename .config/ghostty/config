# vim:fileencoding=utf-8:foldmethod=marker:foldlevel=99

# Fonts {{{
font-family = "JetbrainsMono Nerd Font"
font-size = 11
# }}}

# Mouse {{{
mouse-hide-while-typing = true
copy-on-select = clipboard
# }}}

# Appearance {{{
# background-opacity = 0.95
cursor-invert-fg-bg = true
window-theme = system
# custom-shader = ./shaders/bettercrt.glsl

background = #000000
background-image-opacity = 0.05
background-image = ~/Documents/Image/backgroud/wall-1.jpg
background-image-fit = cover
# minimum-contrast = 2.5

# }}}

# Keybindings {{{
keybind = clear
keybind = ctrl+shift+t=new_tab
keybind = ctrl+tab=next_tab
keybind = ctrl+shift+tab=previous_tab
keybind = ctrl+shift+enter=new_split:auto
keybind = ctrl+shift+space=toggle_split_zoom
keybind = ctrl+shift+right_bracket=goto_split:next
keybind = ctrl+shift+left_bracket=goto_split:previous
keybind = ctrl+shift+comma=reload_config
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
keybind = ctrl+insert=copy_to_clipboard
keybind = shift+insert=paste_from_clipboard
keybind = ctrl+shift++=increase_font_size:1
keybind = ctrl+shift+-=decrease_font_size:1
keybind = ctrl+shift+p=toggle_command_palette
keybind = ctrl+shift+f=start_search
# }}}

# Misc {{{
split-preserve-zoom = navigation
gtk-titlebar-style = tabs

# gtk-single-instance = true
# window-decoration = false
# gtk-toolbar-style = flat

# }}}
